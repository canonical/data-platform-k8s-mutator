# Generated by scripts/gen_webhook_certs.py - do not edit by hand
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ service }}
  namespace: {{ namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ service }}
  template:
    metadata:
      labels:
        app: {{ service }}
    spec:
      containers:
        - name: webhook
          image: {{ image }}
          env:
            - name: TARGET_NAMESPACES
              value: '{{ target_namespaces_json }}'
            - name: TARGET_LABELS
              value: '{{ target_labels_json }}'
            - name: TARGET_CONTAINER_NAMES
              value: '{{ target_container_names_json }}'
            - name: TARGET_IMAGE_SUBSTR
              value: "{{ target_image_substr }}"
            - name: SYSCTL_NAME
              value: "{{ sysctl_name }}"
            - name: SYSCTL_VALUE
              value: "{{ sysctl_value }}"
          ports:
            - containerPort: 8443
              name: https
          volumeMounts:
            - name: tls
              mountPath: /tls
              readOnly: true
          command: ["uvicorn"]
          args:
            - "app:app"
            - "--host=0.0.0.0"
            - "--port=8443"
            - "--ssl-keyfile=/tls/tls.key"
            - "--ssl-certfile=/tls/tls.crt"
      volumes:
        - name: tls
          secret:
            secretName: {{ secret_name }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ service }}
  namespace: {{ namespace }}
spec:
  selector:
    app: {{ service }}
  ports:
    - name: https
      port: 443
      targetPort: 8443
