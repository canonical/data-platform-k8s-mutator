apiVersion: admissionregistration.k8s.io/v1
kind: MutatingWebhookConfiguration
metadata:
  name: {{ webhook_config_name }}
webhooks:
  - name: sysctl-webhook.{{ namespace }}.local
    admissionReviewVersions: ["v1"]
    sideEffects: None
    # If the webhook fails, statefulsets/deployments/daemonsets will not be created.
    failurePolicy: Fail
    matchPolicy: Equivalent
    timeoutSeconds: 5
    clientConfig:
      caBundle: {{ ca_b64 }}
      service:
        name: {{ service }}
        namespace: {{ namespace }}
        path: /mutate
        port: 443
    rules:
      - apiGroups: ["apps"]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["statefulsets", "deployments", "daemonsets"]
